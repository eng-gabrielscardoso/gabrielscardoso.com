# Public
# Overrides `url` from shared/site.config.ts (useful for preview deployments)
NUXT_PUBLIC_SITE_URL=https://example.com
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_CLARITY_ID=

# Contact form (Resend)
NUXT_RESEND_API_KEY=re_xxxxxxxx
# Where submissions are delivered
NUXT_CONTACT_EMAIL=hello@example.com
# Sender address — must belong to a domain verified in Resend
NUXT_CONTACT_FROM_EMAIL=noreply@example.com
NUXT_CONTACT_RATE_LIMIT_SECONDS=3600

# Nuxt Studio (GitHub OAuth)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=

# OG image signing (optional in dev; recommended in production)
NUXT_OG_IMAGE_SECRET=
