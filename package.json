{
  "name": "gabrielscardoso-com",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:runtime": "vitest --project runtime",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commit": "commitlint --from=origin/main --to=HEAD --verbose",
    "typecheck": "nuxt typecheck",
    "security:headers": "uvx --from shcheck shcheck.py http://localhost:3000",
    "security:secrets": "uvx detect-secrets scan",
    "security:vulnerability": "uvx --with greenlet --from wapiti3 wapiti -u http://localhost:3000"
  },
  "dependencies": {
    "@iconify-json/logos": "^1.2.12",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/content": "^3.15.2",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.5.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/scripts": "^1.3.3",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.12",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-bubble-menu": "^3.30.0",
    "@tiptap/extension-code": "^3.30.0",
    "@tiptap/extension-collaboration": "^3.30.0",
    "@tiptap/extension-drag-handle": "^3.30.0",
    "@tiptap/extension-drag-handle-vue-3": "^3.30.0",
    "@tiptap/extension-floating-menu": "^3.30.0",
    "@tiptap/extension-horizontal-rule": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-mention": "^3.30.0",
    "@tiptap/extension-node-range": "^3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/markdown": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@tiptap/suggestion": "^3.30.0",
    "@tiptap/vue-3": "^3.30.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.8.1",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.2",
    "nuxt-security": "2.6.0",
    "nuxt-studio": "^1.7.0",
    "pdf-lib": "1.17.1",
    "resend": "^6.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "^1.62.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.2",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
