#!/bin/sh
# Validates the commit message against commitlint.config.mjs.
# Enabled by the `prepare` script, which points core.hooksPath at .githooks.
if [ ! -x ./node_modules/.bin/commitlint ]; then
  echo "commit-msg: commitlint not installed, run npm install" >&2
  exit 1
fi

exec ./node_modules/.bin/commitlint --edit "$1"
